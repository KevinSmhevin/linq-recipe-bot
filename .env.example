# --- Linq Partner API v3 ---
# Bearer token (provisioned by Linq)
LINQ_PARTNER_TOKEN=
# Secret used to verify inbound webhook signatures from Linq
LINQ_WEBHOOK_SECRET=
# Bot's provisioned Linq phone number, E.164 format
LINQ_FROM_NUMBER=+16462617385
# Linq API base URL (override only for local mock servers)
# LINQ_BASE_URL=https://api.linqapp.com

# --- LLM provider selection ---
# Provider must match exactly one of: anthropic, openai (see app/enums.py:LLMProvider)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# --- Provider keys (only the active provider's key is required) ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Optional overrides ---
# CONVERSATION_TTL_HOURS=24
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# WEBHOOK_DEDUP_TTL_SECONDS=1800
