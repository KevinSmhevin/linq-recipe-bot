# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Linq Partner API v3 bearer token (provisioned by Linq)
LINQ_PARTNER_TOKEN=

# Secret used to verify inbound webhook signatures from Linq
LINQ_WEBHOOK_SECRET=

# Bot's provisioned Linq phone number, E.164 format
LINQ_FROM_NUMBER=+16462617385

# Optional overrides
# CLAUDE_MODEL=claude-haiku-4-5
# CONVERSATION_TTL_HOURS=24
